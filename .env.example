# ==============================================================================
# GoodZeed Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Frontend & Client-side)
# ------------------------------------------------------------------------------
# Required for the storefront and admin panel to connect to Supabase.
# Obtain these from your Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ------------------------------------------------------------------------------
# 2. Supabase Administrative Keys (Backend & Migration CLI only)
# ------------------------------------------------------------------------------
# Required ONLY for running scripts/migrate-store-to-supabase.js seed migration.
# NEVER expose this key in client-side bundles or repository commits.
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ------------------------------------------------------------------------------
# 3. AI Support Chatbot (Gemini)
# ------------------------------------------------------------------------------
# Required for the customer support AI chatbot assistant (POST /api/support/ai).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 4. Express Server & Hosting Options
# ------------------------------------------------------------------------------
PORT=7392
NODE_ENV="development"
APP_URL="MY_APP_URL"
